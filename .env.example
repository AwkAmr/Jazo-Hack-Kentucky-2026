# JAZO configuration.
#
#   Local dev : copy to .env.local
#   Vultr     : copy to .env next to docker-compose.yml
#
# Names are case-sensitive on Linux. Windows tolerates a typo in a variable
# name because its environment is case-insensitive; the Vultr box will not, and
# a mistyped key surfaces as a 500 from /api/tts rather than an obvious error.
# `curl https://<domain>/api/health` reports which keys the server actually sees.

# --- Deploy (read by docker-compose + Caddy, not by the app) ---------------

# Must already resolve to the instance's public IP before the first
# `docker compose up`, or the certificate request will fail.
JAZO_DOMAIN=jazo.example.com
# Let's Encrypt expiry notices.
ACME_EMAIL=you@example.com

# --- Interviewer brain (required) -----------------------------------------

# /api/chat drives each interview turn. Either GEMINI_API_KEY or
# GOOGLE_CLOUD_PROJECT is required; the API key is the simpler of the two.
GEMINI_API_KEY=
# Alternative to the above: use Vertex AI with ambient Google credentials.
# GOOGLE_CLOUD_PROJECT=

# --- Voice (required) ------------------------------------------------------

# Used by both /api/tts (speech) and /api/stt (transcribing push-to-talk).
ELEVENLABS_API_KEY=

# Jazo speaks with the "eve" voice; the app falls back to a built-in public
# voice id if this is unset. CASSIDY has no fallback and is currently unused by
# the UI.
ELEVENLABS_VOICE_ID_EVE=
ELEVENLABS_VOICE_ID_CASSIDY=

# --- Final story (optional) ------------------------------------------------

# With a key set, /api/generate-story writes the story with Claude reading the
# transcript through the JAZO MCP server. Unset, it falls back to Gemini, so
# the app still works end to end without it.
ANTHROPIC_API_KEY=

# Points the story generator at an out-of-process MCP server. Leave unset to
# use this app's own /api/mcp route.
# JAZO_MCP_URL=
